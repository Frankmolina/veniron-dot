<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Accessory app: no Dock icon, even before the activation policy is applied. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Voice input (S30.1): shown by macOS the first time the mic button is used. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>VENIRON escucha tu voz cuando pulsas el botón del micrófono.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>VENIRON convierte lo que dices en un mensaje cuando pulsas el botón del micrófono.</string>
</dict>
</plist>
